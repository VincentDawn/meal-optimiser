{
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": true,
  "trailingComma": "es5",
  "bracketSpacing": true,
  "arrowParens": "avoid",
  "overrides": [
    {
      "files": ["*.html"],
      "options": { "printWidth": 120, "htmlWhitespaceSensitivity": "ignore" }
    },
    {
      "files": ["meal-data.js"],
      "options": { "printWidth": 200 }
    }
  ]
}
